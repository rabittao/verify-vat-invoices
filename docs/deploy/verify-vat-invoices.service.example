[Unit]
Description=verify-vat-invoices FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/verify-vat-invoices
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/verify-vat-invoices/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
